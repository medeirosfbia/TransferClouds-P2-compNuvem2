# Copie para .env e preencha
FLASK_SECRET_KEY=troque-por-uma-string-aleatoria
# Local: caminho do JSON da Service Account
GOOGLE_APPLICATION_CREDENTIALS=credentials.json
# Deploy: cole o conteúdo inteiro do JSON nesta variável (em vez da de cima)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Só para o modo console (python migrador.py)
DRIVE_FOLDER_ID=
AZURE_STORAGE_CONNECTION_STRING=cole-a-connection-string-aqui
AZURE_CONTAINER=aluno-seunome

# Upload para o Drive (token gerado com gerar_token.py)
GOOGLE_OAUTH_TOKEN_FILE=token.json
# Deploy: GOOGLE_OAUTH_TOKEN_JSON={"token":...}
DRIVE_UPLOAD=0   # 1 = liga o upload para o Drive (requer token.json)
